---
import Layout from '../../layouts/Layout.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import { projects, type Project } from '../../data/projects';
import { href } from '../../data/site';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project; }
const { project } = Astro.props;
const demoFiles = import.meta.glob('/public/media/projects/*.mp4', { query: '?url', import: 'default' });
const hasDemoVideo = project.demoVideo && `/public/${project.demoVideo}` in demoFiles;
const figureFiles = import.meta.glob('/public/images/projects/**/*.{png,jpg,jpeg,webp,gif}', { query: '?url', import: 'default' });
const availableFigures = project.figures?.filter(figure => `/public/${figure.image}` in figureFiles) ?? [];
---
<Layout title={project.title} description={project.subtitle}>
  <article class="container detail-page">
    <a class="back-link" href={href('projects/')}>← All projects</a>
    <div class="detail-head">
      <div>
        <p class="eyebrow">{project.eyebrow} <span class="detail-number">/ {project.number}</span></p>
        <h1>{project.title}<span class="accent-dot">.</span></h1>
        <p class="detail-subtitle">{project.subtitle}</p>
      </div>
      <div class="detail-links">
        {project.demoUrl && <a class="button button-primary" href={project.demoUrl} target="_blank" rel="noopener noreferrer">Live Demo ↗</a>}
        {project.github && <a class="button button-primary" href={project.github} target="_blank" rel="noopener noreferrer">View code ↗</a>}
        {project.paper && <a class="button button-outline" href={project.paper} target="_blank" rel="noopener noreferrer">{project.paperLabel ?? 'Read paper'} ↗</a>}
      </div>
    </div>
    <div class="detail-body">
      <div class="detail-main">
        <section>
          <h2>Overview</h2>
          <p>{project.introduction}</p>
          {project.overviewFigure && `/public/${project.overviewFigure.image}` in figureFiles && <ProjectFigure figure={project.overviewFigure} />}
        </section>
        {hasDemoVideo && project.demoVideo && (
          <section aria-labelledby="demo-heading">
            <h2 id="demo-heading">Demo</h2>
            <video class="project-demo" controls playsinline preload="none" aria-label={`${project.title} demonstration`}>
              <source src={href(project.demoVideo)} type="video/mp4" />
              <a href={href(project.demoVideo)}>Download the demo video</a>
            </video>
          </section>
        )}
        <section>
          <h2>{project.approachTitle ?? 'Approach'}</h2>
          <p>{project.approach}</p>
        </section>
        {project.sections?.map(section => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            {section.bullets && <ul class="detail-bullets">{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
            {section.figures?.filter(figure => `/public/${figure.image}` in figureFiles).map(figure => <ProjectFigure figure={figure} />)}
          </section>
        ))}
        {availableFigures.length > 0 && (
          <div class="project-figures">
            {availableFigures.map(figure => (
              <ProjectFigure figure={figure} />
            ))}
          </div>
        )}
        {project.highlights.length > 0 && <section>
          <h2>{project.highlightsTitle ?? 'Selected contributions'}</h2>
          <ul class="detail-bullets">{project.highlights.map(highlight => <li>{highlight}</li>)}</ul>
        </section>}
        <section class="availability-note">
          <h2>Code & materials</h2>
          <p>{project.codeNote}</p>
          {project.github && <a class="text-link" href={project.github} target="_blank" rel="noopener noreferrer">View available repository ↗</a>}
        </section>
      </div>
      <aside class="detail-sidebar">
        <div class="sidebar-block"><span class="sidebar-label">PROJECT CONTEXT</span><p>{project.context}</p></div>
        <div class="sidebar-block"><span class="sidebar-label">CATEGORY</span><p>{project.category}</p></div>
        {project.year && <div class="sidebar-block"><span class="sidebar-label">PERIOD</span><p>{project.year}</p></div>}
        <div class="sidebar-block"><span class="sidebar-label">TECHNOLOGIES / TOPICS</span><div class="tag-row">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div></div>
      </aside>
    </div>
    <div class="next-project"><p>KEEP EXPLORING</p><a href={href('projects/')}>All projects <span aria-hidden="true">↗</span></a></div>
  </article>
</Layout>
<style>
  .project-demo { display: block; width: 100%; height: auto; max-height: 70svh; background: #0a0a0a; border: 1px solid var(--hairline); }
  .project-figures { margin-bottom: 45px; }
</style>
