---
import Layout from '../layouts/Layout.astro';
import { photos, drawings } from '../data/beyond';
import { href } from '../data/site';
const asset = (path: string) => /^https?:\/\//.test(path) ? path : href(path);
const viewable = photos.filter(photo => photo.image);
---
<Layout title="Beyond Engineering" description="A little collection of photography, music, and guitar — Xun Gao outside of research and code.">
  <div class="container creative-page">
    <section class="creative-intro" aria-labelledby="creative-title">
      <h1 id="creative-title">Beyond <em>Engineering.</em></h1>
      <p class="creative-subtitle">A little collection of things I enjoy outside of research and code.</p>
      <p class="intro-note">Outside of engineering, I enjoy exploring the world through photography and music. Whether it's capturing an interesting moment with my camera, discovering a new song, or spending time playing guitar, I like finding little ways to be creative.</p>
      <div class="chapter-links"><a href="#photography">01 / Photography</a><a href="#drawing">02 / Drawing & sketching</a><a href="#music">03 / Music & guitar</a></div>
    </section>

    <section class="creative-section" id="photography" aria-labelledby="photo-heading">
      <header class="creative-section-head">
        <span class="chapter-number" aria-hidden="true">01</span>
        <div><h2 id="photo-heading">Through My <em>Lens</em></h2></div>
      </header>
      <div class="photo-grid">
        {photos.map((photo, index) => (
          <figure class:list={['photo', photo.orientation === 'portrait' ? 'portrait' : 'landscape']}>
            {photo.image ? (
              <button class="photo-open photo-surface" type="button" data-photo-index={viewable.indexOf(photo)} aria-label={`Enlarge ${photo.title || photo.alt || `photograph ${index + 1}`}`}>
                <img src={asset(photo.image)} alt={photo.alt || photo.title || 'Personal photograph'} loading="lazy" decoding="async" width={photo.orientation === 'portrait' ? 900 : 1350} height={photo.orientation === 'portrait' ? 1200 : 900} />
                <span class="enlarge" aria-hidden="true">↗</span>
              </button>
            ) : (
              <div class="photo-surface photo-placeholder">
                <span class="placeholder-index">FRAME / {String(index + 1).padStart(2, '0')}</span>
                <span class="frame-mark" aria-hidden="true">+</span>
                <span class="placeholder-copy">{photo.title || 'An unwritten frame'}<small>Photograph to come</small></span>
              </div>
            )}
            <figcaption><span>{photo.image ? photo.title : 'Placeholder'}{photo.location && ` · ${photo.location}`}{photo.date && ` · ${photo.date}`}</span>{photo.caption && <span class="photo-caption">{photo.caption}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="creative-section" id="drawing" aria-labelledby="drawing-heading">
      <header class="creative-section-head">
        <span class="chapter-number" aria-hidden="true">02</span>
        <div><h2 id="drawing-heading">Drawing & <em>Sketching</em></h2></div>
      </header>
      <p class="drawing-intro">I also enjoy drawing and sketching, capturing ideas and little details through a different perspective.</p>
      <div class="drawing-grid">
        {drawings.map((drawing, index) => (
          <figure class="drawing">
            <div class:list={['drawing-surface', { 'has-drawing': drawing.image }]}>
              {drawing.image ? (
                <img src={asset(drawing.image)} alt={drawing.alt || drawing.title || 'Personal drawing'} width="1000" height="1000" loading="lazy" decoding="async" />
              ) : (
                <div class="drawing-placeholder">
                  <span class="placeholder-index">SKETCH / {String(index + 1).padStart(2, '0')}</span>
                  <span class="sketch-lines" aria-hidden="true"></span>
                  <span class="placeholder-copy">{drawing.title || 'An open page'}<small>Drawing to come</small></span>
                </div>
              )}
            </div>
            {(drawing.title || drawing.caption) && <figcaption>{drawing.title && <span>{drawing.image ? drawing.title : `${drawing.title} · Placeholder`}</span>}{drawing.caption && <span class="photo-caption">{drawing.caption}</span>}</figcaption>}
          </figure>
        ))}
      </div>
    </section>

    <section class="creative-section" id="music" aria-labelledby="music-heading">
      <header class="creative-section-head">
        <span class="chapter-number" aria-hidden="true">03</span>
        <div><h2 id="music-heading">Life in <em>Music</em></h2></div>
      </header>
      <div class="music-intro">
        <p>Sometimes it's discovering a new song. Sometimes it's picking up the guitar and working through a few chords. I enjoy having a little space to play, listen, and follow whatever catches my ear.</p>
        <span class="music-staff" aria-hidden="true">♪</span>
      </div>
    </section>

    <section class="creative-closing" aria-label="Closing note">
      <span aria-hidden="true">✳</span>
      <p>There's more to life than debugging code <em>(although I do spend quite a lot of time doing that).</em></p>
      <a href={href()}>Back to my portfolio <span aria-hidden="true">↗</span></a>
    </section>
  </div>
  {viewable.length > 0 && (
    <dialog class="photo-dialog" aria-label="Photo viewer">
      <button class="viewer-close" type="button" aria-label="Close photo viewer">Close ×</button>
      <div class="viewer-content"><img class="viewer-image" alt="" /><p class="viewer-caption"></p></div>
      <div class="viewer-controls"><button type="button" class="viewer-prev" aria-label="Previous photograph">← Previous</button><span class="viewer-count" aria-live="polite"></span><button type="button" class="viewer-next" aria-label="Next photograph">Next →</button></div>
    </dialog>
    <script type="application/json" id="photo-data" set:html={JSON.stringify(viewable.map(photo => ({ src: asset(photo.image!), alt: photo.alt || photo.title || 'Personal photograph', caption: [photo.title, photo.location, photo.date, photo.caption].filter(Boolean).join(' · ') }))).replace(/</g, '\\u003c')} />
  )}
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
  const data = document.querySelector('#photo-data');
  if (dialog && data) {
    const photos: { src: string; alt: string; caption: string }[] = JSON.parse(data.textContent || '[]');
    const img = dialog.querySelector<HTMLImageElement>('.viewer-image')!;
    const caption = dialog.querySelector<HTMLElement>('.viewer-caption')!;
    const count = dialog.querySelector<HTMLElement>('.viewer-count')!;
    let current = 0;
    const show = (index: number) => {
      current = (index + photos.length) % photos.length;
      img.src = photos[current].src;
      img.alt = photos[current].alt;
      caption.textContent = photos[current].caption;
      count.textContent = `${current + 1} / ${photos.length}`;
    };
    document.querySelectorAll<HTMLButtonElement>('[data-photo-index]').forEach(button => {
      button.addEventListener('click', () => { show(Number(button.dataset.photoIndex)); dialog.showModal(); });
    });
    dialog.querySelector('.viewer-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.viewer-prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.viewer-next')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); show(current + (event.key === 'ArrowLeft' ? -1 : 1)); }
    });
  }
</script>

<style>
  .creative-page { --creative-muted: #aaa69f; --creative-line: #33312e; --creative-paper: #eee9df; color: var(--creative-paper); }
  .creative-intro { padding-block: 85px 70px; }
  .kicker, .chapter-links, .margin-note, .chapter-number, .entry-label, figcaption, .placeholder-index { font-size: .65rem; letter-spacing: .08em; color: var(--creative-muted); }
  .kicker { text-transform: uppercase; margin-bottom: 28px; }
  .creative-intro h1 { max-width: 1100px; margin-bottom: 24px; }
  em { font-family: "Times New Roman", Times, serif; font-weight: 400; }
  h1 em, h2 em, h3 em, h4 em { font-style: normal; }
  .creative-subtitle { font-size: 1.05rem; color: var(--creative-paper); line-height: 1.7; }
  .creative-page p { text-align: left; hyphens: none; }
  .intro-note { max-width: 860px; color: var(--creative-muted); font-size: .9rem; line-height: 1.9; margin-top: 28px; }
  .chapter-links { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 38px; }
  .chapter-links a { padding-bottom: 7px; border-bottom: 1px solid #55514b; }
  .chapter-links a:hover { color: #fff; border-color: #fff; }
  .creative-section { border-top: 1px solid var(--creative-line); padding-block: 40px 85px; scroll-margin-top: 24px; }
  .creative-section-head { display: flex; gap: 24px; align-items: baseline; margin-bottom: 40px; }
  .creative-section-head h2 { font-size: clamp(1.7rem, 3.5vw, 2.7rem); margin-bottom: 12px; letter-spacing: -.045em; }
  .creative-section-head p { font-size: .8rem; line-height: 1.7; color: var(--creative-muted); margin: 0; }
  .margin-note { margin-left: auto; text-align: right; }
  .photo-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 24px 28px; align-items: start; }
  .photo { margin: 0; min-width: 0; }
  .photo.portrait { grid-row: span 2; padding-top: 0; }
  .photo-surface { position: relative; display: block; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; border: 1px solid #ffffff0d; background: #1c1b19; }
  .portrait .photo-surface { aspect-ratio: 2 / 3; }
  .photo:nth-child(4n + 2) .photo-surface { background: #242320; }
  .photo:nth-child(4n + 3) .photo-surface { background: #191a1a; }
  .photo:nth-child(4n + 4) .photo-surface { background: #262421; }
  .photo-open { padding: 0; cursor: zoom-in; }
  .photo-open img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .45s; }
  .photo-open:hover img { transform: scale(1.025); }
  .enlarge { position: absolute; right: 16px; bottom: 16px; display: grid; place-items: center; width: 36px; height: 36px; background: #0009; color: white; border-radius: 50%; }
  .photo-placeholder { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(18px, 3vw, 40px); }
  .placeholder-index { font-size: .55rem; }
  .frame-mark { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%,-50%); font-size: 2rem; font-weight: 200; color: #ffffff25; }
  .placeholder-copy { font-family: "Times New Roman", Times, serif; font-style: italic; font-size: clamp(1rem, 2vw, 1.6rem); line-height: 1.5; color: #ccc5ba; }
  .placeholder-copy small, .guitar-placeholder small { display: block; font: .6rem/1.8 "Times New Roman", Times, serif; letter-spacing: .04em; color: var(--creative-muted); margin-top: 8px; }
  figcaption { display: flex; flex-direction: column; gap: 5px; padding-top: 14px; line-height: 1.7; letter-spacing: .015em; }
  .photo-caption { color: #88857f; }
  .drawing-intro { max-width: 760px; font-size: .9rem; line-height: 1.9; color: var(--creative-muted); margin-bottom: 36px; }
  .drawing-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .drawing { margin: 0; min-width: 0; }
  .drawing-surface { aspect-ratio: 1; background: #1c1b19; border: 1px solid #ffffff0d; overflow: hidden; }
  .drawing-surface img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .drawing-surface.has-drawing { aspect-ratio: auto; background: transparent; border: 0; }
  .drawing-surface.has-drawing img { height: auto; }
  .drawing-placeholder { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(18px, 3vw, 40px); }
  .sketch-lines { position: absolute; top: 28%; left: 32%; width: 35%; height: 40%; border: 1px solid #ccc5ba20; transform: rotate(-8deg); }
  .sketch-lines::after { content: ''; position: absolute; inset: 12% -10% -8% 15%; border: 1px solid #ccc5ba16; transform: rotate(18deg); }
  @media (max-width: 640px) { .drawing-grid { grid-template-columns: 1fr; } }
  .music-intro { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-bottom: 45px; }
  .music-intro p { max-width: 760px; color: var(--creative-muted); font-size: .9rem; line-height: 1.9; margin-bottom: 0; }
  .music-staff { font: italic 5rem "Times New Roman", Times, serif; color: #59544c; margin-right: 8%; }
  .music-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: 70px; }
  .listening-notes .kicker { margin-bottom: 18px; }
  .music-entry { display: grid; grid-template-columns: 85px minmax(0, 1fr); gap: 24px; border-top: 1px solid var(--creative-line); padding-block: 26px; }
  .album-cover { display: grid; place-items: center; align-self: start; aspect-ratio: 1; background: #24221e; overflow: hidden; }
  .album-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .record { width: 65%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; border: 1px solid #6c665a; box-shadow: 0 0 0 5px #ffffff04, inset 0 0 0 5px #ffffff04; }
  .record span { width: 18%; aspect-ratio: 1; border-radius: 50%; background: #a79c88; }
  .entry-label { font-size: .52rem; text-transform: uppercase; }
  .music-entry h4 { font-size: .95rem; line-height: 1.5; font-weight: 500; margin: 7px 0; }
  .music-entry p, .artist { font-size: .73rem; line-height: 1.8; color: var(--creative-muted); margin-bottom: 0; }
  .music-link { display: inline-block; font-size: .7rem; margin-top: 12px; border-bottom: 1px solid #777; }
  .guitar-note { margin: 0; min-width: 0; }
  .guitar-media { aspect-ratio: 4 / 5; background: #1d1c19; overflow: hidden; }
  .guitar-media img { width: 100%; height: 100%; object-fit: cover; }
  .guitar-placeholder { height: 100%; position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 30px; overflow: hidden; }
  .guitar-placeholder > span:last-child { font: italic 1.4rem/1.5 "Times New Roman", Times, serif; z-index: 1; }
  .guitar-strings { position: absolute; inset: 0 15% 0 35%; display: flex; justify-content: space-between; transform: rotate(18deg); }
  .guitar-strings i { height: 100%; width: 1px; background: #ffffff13; }
  .guitar-strings i:nth-child(n+4) { width: 2px; }
  audio, video { display: block; width: 100%; margin-top: 16px; }
  .creative-closing { border-top: 1px solid var(--creative-line); padding-block: 65px; text-align: center; }
  .creative-closing > span { color: #aaa18e; font-size: 1.4rem; }
  .creative-closing p { max-width: 700px; margin: 22px auto; font-size: 1.15rem; line-height: 1.7; text-align: center; }
  .creative-closing em { color: var(--creative-muted); }
  .creative-closing a { font-size: .7rem; color: var(--creative-muted); padding-bottom: 6px; border-bottom: 1px solid #55514b; }
  .photo-dialog { width: 100vw; height: 100dvh; max-width: none; max-height: none; border: 0; padding: 70px 24px 24px; background: #0a0a0afa; color: #fff; }
  .photo-dialog::backdrop { background: #000d; }
  .viewer-close { position: absolute; top: 20px; right: 24px; }
  .photo-dialog button { background: transparent; border: 1px solid #555; border-radius: 4px; padding: 10px 16px; color: #fff; cursor: pointer; font-size: .75rem; }
  .viewer-content { display: flex; flex-direction: column; align-items: center; }
  .viewer-image { max-width: 100%; max-height: 68dvh; object-fit: contain; }
  .viewer-caption { font-size: .75rem; line-height: 1.6; margin: 15px 0; }
  .viewer-controls { display: flex; justify-content: center; align-items: center; gap: 20px; }
  .viewer-count { font-size: .7rem; }
  @media (max-width: 900px) { .music-layout { gap: 30px; } .margin-note { display: none; } }
  @media (max-width: 640px) {
    .creative-intro { padding-block: 50px; }
    .creative-section { padding-block: 28px 50px; }
    .creative-section-head { gap: 14px; margin-bottom: 28px; }
    .photo-grid, .music-layout { grid-template-columns: 1fr; gap: 28px; }
    .photo.portrait { grid-row: auto; }
    .music-staff { display: none; }
    .music-entry { grid-template-columns: 65px minmax(0,1fr); gap: 18px; }
    .guitar-media { aspect-ratio: 1; }
    .creative-closing { padding-block: 45px; }
    .viewer-controls { gap: 10px; }
    .photo-dialog button { padding: 10px; }
  }
</style>
