---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Publications" description="Papers and patents by Xun Gao.">
  <section class="container page-hero publications-hero">
    <h1><em>Publications.</em></h1>
  </section>
  <section class="container publication-section" aria-labelledby="papers-heading">
    <h2 id="papers-heading"><span class="section-index" aria-hidden="true">01</span> Papers</h2>
    <article class="publication-entry">
      <span class="pub-year">June 2023 · IEEE Photonics Journal</span>
      <h3>A MEMS Mirror-Based Confocal Laser Endomicroscope with Image Distortion Correction</h3>
      <p>Second author · DOI: 10.1109/JPHOT.2023.3264597.</p>
      <a href="https://doi.org/10.1109/JPHOT.2023.3264597" target="_blank" rel="noopener noreferrer" class="text-link">Read paper <span aria-hidden="true">↗</span></a>
    </article>
  </section>
  <section class="container publication-section" aria-labelledby="patents-heading">
    <h2 id="patents-heading"><span class="section-index" aria-hidden="true">02</span> Patents</h2>
    <article class="publication-entry">
      <span class="pub-year">CN Patent Application · CN117572392A</span>
      <h3>A Camera–LiDAR Joint Calibration Method and Device Based on 3D–3D Matching Point Pairs</h3>
      <p>First inventor · Under substantive examination.</p>
    </article>
  </section>
</Layout>
<style>
  .publications-hero { padding-bottom: 56px; }
  .publications-hero h1 { margin-bottom: 0; }
  .publication-section { padding-bottom: 56px; }
</style>
