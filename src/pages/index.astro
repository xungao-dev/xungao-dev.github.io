---
import Layout from '../layouts/Layout.astro';
import { href } from '../data/site';
---
<Layout>
  <section class="container home-intro">
    <h1>Hi, I'm Xun.</h1>
    <p class="hero-intro">I work with machine learning, computer vision, and signal processing — turning research ideas into working systems.</p>
    <nav class="intro-links" aria-label="Main navigation">
      <a class="intro-button intro-button-work" href={href('projects/')}>
        Explore my projects <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </section>
</Layout>
