---
import Layout from '../layouts/Layout.astro';
import { href, site } from '../data/site';
---
<Layout>
  <section class="container home-intro" style={{ '--home-atmosphere': `url("${href('images/home-atmosphere.svg')}")` }}>
    <h1>Hi, I'm <em>Xun.</em></h1>
    <div class:list={['personal-intro', { 'has-portrait': site.portrait }]}>
    <div class="personal-copy">
    <div class="intro-description">
      <p class="hero-intro">I'm a recent MSc graduate from KTH Royal Institute of Technology, with a background in multimedia signal processing and experience in applied machine learning research, autonomous systems, and software development.</p>
      <p class="hero-intro">I enjoy turning research ideas into practical engineering solutions and exploring how intelligent systems can help us better understand the world.</p>
    </div>
    </div>
    {site.portrait && <img class="personal-portrait" src={href(site.portrait)} alt="Portrait of Xun Gao" width="600" height="750" decoding="async" fetchpriority="high" />}
    </div>
    <ul class="intro-interests" aria-label="Areas of interest">
      <li>Signal Processing</li>
      <li>Machine Learning</li>
      <li>Computer Vision</li>
      <li>Audio &amp; Acoustics</li>
      <li>Software Engineering</li>
      <li>Robotics &amp; Autonomous Systems</li>
      <li>Biomedical Engineering</li>
    </ul>

  </section>
</Layout
