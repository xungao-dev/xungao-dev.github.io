---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';
import { href, site } from '../data/site';
---
<Layout>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> ENGINEER · RESEARCHER · BUILDER</div>
        <h1>Making sense of <em>signals,</em> <em>geometry,</em> and data<span class="accent-dot">.</span></h1>
        <p class="hero-intro">Hi, I'm <strong>Xun</strong> — a Stockholm-based engineer with a background in machine learning, computer vision and multimedia signal processing. I enjoy turning research ideas into working systems.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={href('projects/')}>Explore my work <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-footnote"><span class="status-dot"></span> Based in Stockholm, Sweden</div>
      </div>
      <div class="hero-visual" aria-label="Decorative abstract visualization of data and geometry">
        <div class="visual-grid"></div>
        <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div>
        <div class="visual-axis visual-axis-a"></div><div class="visual-axis visual-axis-b"></div>
        <div class="visual-center"><span>ML</span><small>+ research</small></div>
        <div class="visual-label visual-label-top"><span class="mini-swatch"></span> 3D perception</div>
        <div class="visual-label visual-label-bottom">signal → model → insight</div>
        <div class="orb orb-one"></div><div class="orb orb-two"></div><div class="orb orb-three"></div>
        <div class="visual-code">pointcloud<br/>∑ signal<br/>{`{ model }`}</div>
      </div>
    </div>
  </section>

  <section class="expertise-strip" aria-label="Areas of expertise">
    <div class="container strip-content">
      <span class="strip-title">AREAS I WORK IN</span>
      <span>Machine Learning</span><span class="strip-star">✳</span>
      <span>Computer Vision</span><span class="strip-star">✳</span>
      <span>Signal Processing</span><span class="strip-star">✳</span>
      <span>Software Engineering</span>
    </div>
  </section>

  <section class="section-pad" id="featured">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / SELECTED WORK</p>
          <h2>Projects at the intersection of <em>research and engineering.</em></h2>
        </div>
        <a class="text-link" href={href('projects/')}>View all projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">
        {featuredProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="about-teaser section-pad">
    <div class="container about-teaser-grid">
      <div>
        <p class="eyebrow">02 / BACKGROUND</p>
        <h2>Curiosity across <em>disciplines.</em><br/>Depth in the details.</h2>
      </div>
      <div class="teaser-body">
        <p>My work spans 3D geometric learning, autonomous driving perception, biomedical image analysis, and software development. I have studied at KTH and worked on research and engineering projects in both academic and industry settings.</p>
        <a class="text-link" href={href('about/')}>More about me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="container contact-section">
    <div class="contact-banner">
      <div>
        <p class="eyebrow light-eyebrow">03 / LET'S CONNECT</p>
        <h2>Interested in building <em>something meaningful?</em></h2>
        <p>I'm always happy to connect about research, engineering and interesting ideas.</p>
      </div>
      <a href={`mailto:${site.email}`} class="button button-white">Say hello <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
