---
import type { Art } from '../data/projects';
interface Props { type: Art; }
const { type } = Astro.props;
const dots = Array.from({ length: 72 }, (_, i) => ({
  x: 56 + ((i * 53 + Math.floor(i / 9) * 29) % 222),
  y: 27 + ((i * 37 + Math.floor(i / 5) * 17) % 158),
  r: i % 8 === 0 ? 3 : 1.75,
}));
---
<div class={`project-art art-${type}`} aria-hidden="true">
  {type === 'geometry' && (
    <svg viewBox="0 0 340 230" class="art-svg">
      <path d="M62 70 170 24 282 69 172 119Z M62 70V157L172 206V119 M172 206 282 159V69" fill="none" stroke="currentColor" opacity=".2" stroke-width="2"/>
      <path d="M62 157 170 107 282 159 M170 24 170 107" fill="none" stroke="currentColor" opacity=".12" stroke-width="2"/>
      {dots.map((dot, i) => <circle cx={dot.x} cy={dot.y} r={dot.r} fill={i % 5 === 0 ? '#D89658' : '#4F9E94'} opacity={.33 + (i % 5) * .12}/>) }
      <circle cx="239" cy="71" r="6" fill="#D89658"/>
    </svg>
  )}
  {type === 'radar' && (
    <svg viewBox="0 0 340 230" class="art-svg">
      <g transform="translate(171 119)" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3">
        <circle r="75"/><circle r="54"/><circle r="32"/><path d="M-101 0H101M0-100V100"/>
        <path d="M0 0 54-54" stroke-width="3" opacity=".6"/>
      </g>
      <g fill="#D89559"><circle cx="223" cy="65" r="7"/><circle cx="116" cy="138" r="5"/><circle cx="194" cy="169" r="6"/></g>
      <path d="M163 111 181 111 190 131 154 131Z M166 98H179M158 133H186" stroke="#244B58" stroke-width="3" stroke-linecap="round" fill="none"/>
      <path d="M60 176 106 157M248 69 291 47" stroke="#D89559" stroke-width="1.5" stroke-dasharray="4 5"/>
    </svg>
  )}
  {type === 'activity' && (
    <svg viewBox="0 0 340 230" class="art-svg">
      {[70,110,150,190].map(y => <line x1="27" y1={y} x2="314" y2={y} stroke="currentColor" opacity=".13" />)}
      <path d="M30 132 40 131 52 134 62 90 77 174 90 114 103 129 114 123 125 134 137 63 151 170 165 105 177 129 194 130 209 93 220 158 235 117 250 127 264 126 278 70 291 159 307 128" fill="none" stroke="#287970" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
      <g fill="#C78A54"><circle cx="62" cy="90" r="6"/><circle cx="137" cy="63" r="6"/><circle cx="278" cy="70" r="6"/></g>
    </svg>
  )}
  {type === 'eye' && (
    <svg viewBox="0 0 340 230" class="art-svg">
      <circle cx="170" cy="116" r="85" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".2" stroke-dasharray="6 5"/>
      <path d="M58 115Q170 9 282 115Q170 220 58 115Z" fill="#F6E0C7" stroke="#B17F5B" stroke-width="2"/>
      <circle cx="170" cy="115" r="58" fill="#9DAF9B"/><circle cx="170" cy="115" r="38" fill="#426F69"/><circle cx="170" cy="115" r="21" fill="#182E32"/>
      <circle cx="154" cy="98" r="11" fill="white" opacity=".85"/><circle cx="189" cy="135" r="4" fill="white" opacity=".45"/>
      <path d="M235 55l20-20M85 169 67 186" stroke="#D5965C" stroke-width="3" stroke-linecap="round"/>
    </svg>
  )}
  {type === 'emotion' && (
    <svg viewBox="0 0 340 230" class="art-svg">
      <rect x="57" y="37" width="228" height="160" rx="14" fill="#F8F5EC" stroke="#6D9F97" stroke-width="1.5"/>
      <circle cx="146" cy="109" r="43" fill="#C2DFD5"/>
      <g fill="#23494A"><circle cx="132" cy="101" r="4"/><circle cx="161" cy="101" r="4"/></g>
      <path d="M130 121Q147 142 163 121" stroke="#23494A" stroke-width="3" stroke-linecap="round" fill="none"/>
      <path d="M223 83h33M223 104h22M223 125h39" stroke="#7BAFA3" stroke-width="7" stroke-linecap="round"/>
      <path d="M222 161q9-16 16 0t16 0t16 0" fill="none" stroke="#D79555" stroke-width="3"/>
    </svg>
  )}
  {type === 'game' && (
    <svg viewBox="0 0 340 230" class="art-svg">
      <path d="M80 85Q87 58 114 60H225Q252 58 260 85L283 155Q288 181 263 187Q251 190 236 177L205 151H135L103 178Q85 194 70 184Q55 174 62 153Z" fill="#E8E0CA" stroke="#466B64" stroke-width="3"/>
      <path d="M114 104V140M96 122H132" stroke="#466B64" stroke-width="8" stroke-linecap="round"/>
      <g fill="#D29157"><circle cx="224" cy="108" r="9"/><circle cx="246" cy="131" r="9"/></g>
      <circle cx="167" cy="111" r="5" fill="#466B64"/><circle cx="187" cy="111" r="5" fill="#466B64"/>
      <path d="M35 57h48M262 47h39M40 185h21" stroke="#466B64" stroke-width="2" opacity=".35"/>
    </svg>
  )}
  <span class="art-corner">XG / LAB</span>
</div>
<style>
  .project-art{height:100%;min-height:200px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#2d7774;background:#eaf2e9}
  .art-geometry{background:linear-gradient(133deg,#e4f1e8,#cbdad8)}
  .art-radar{background:linear-gradient(135deg,#edf0e6,#d9e2d4);color:#4c817c}
  .art-activity{background:linear-gradient(133deg,#edf3e7,#dce7dd)}
  .art-eye{background:linear-gradient(125deg,#f2eae1,#eddfcf)}
  .art-emotion{background:linear-gradient(125deg,#e4f2ee,#d6e6e2)}
  .art-game{background:linear-gradient(125deg,#eaece0,#d6dfd4)}
  .project-art:before{content:'';position:absolute;inset:0;opacity:.28;background-image:radial-gradient(#5a8981 .8px, transparent .8px);background-size:24px 24px;mask-image:linear-gradient(120deg,transparent,black)}
  .art-svg{position:relative;width:min(93%,370px);max-height:100%;filter:drop-shadow(0 15px 18px rgb(22 57 49 / 6%))}
  .art-corner{position:absolute;right:16px;bottom:13px;font-size:10px;letter-spacing:.16em;font-weight:700;color:rgb(25 73 71 / 50%)}
</style>
