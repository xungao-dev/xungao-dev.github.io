---
import { href, site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-name">Xun Gao<span class="accent-dot">.</span></div>
      <p>Machine learning, perception, and thoughtful engineering.</p>
    </div>
    <div class="footer-links">
      <a href={href('projects/')}>Projects</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={`mailto:${site.email}`}>Email ↗</a>
    </div>
  </div>
  <div class="container copyright">© {new Date().getFullYear()} Xun Gao · Built with Astro · Stockholm, Sweden</div>
</footer>
