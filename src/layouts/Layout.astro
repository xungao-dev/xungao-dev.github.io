---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { href, site } from '../data/site';
interface Props { title?: string; description?: string; }
const { title, description = 'Projects and research by Xun Gao, a Stockholm-based engineer working across machine learning, computer vision and signal processing.' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — Engineering & Research`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
